DATA_GO_KR_SERVICE_KEY=

# -------------------------------------------------------------
# 2. OpenAI 규격 AI 서버 연동 설정
# -------------------------------------------------------------
# AI 서버 주소 (/v1 포함 엔드포인트. 예: https://api.openai.com/v1 또는 사설 AI 서버 주소)
OPENAI_BASE_URL=https://api.openai.com/v1

# AI 서버 API 인증키
OPENAI_API_KEY=

# 사용할 모델명 (예: gpt-4o-mini, gpt-4o, 등)
OPENAI_MODEL=gpt-4o-mini
